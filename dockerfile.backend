# target path: Dockerfile.backend (new file)
#
# Builds and runs the FastAPI API only -- the Dash frontend is a separate
# service/image (see Dockerfile.frontend), deployed independently and
# talking to this one over HTTP via API_BASE_URL. On Railway, point one
# service at this file (Settings -> Deploy -> Dockerfile Path) and a
# second at Dockerfile.frontend, both pointing at the same GitHub repo.
FROM python:3.11-slim

WORKDIR /app

# hatchling's [tool.hatch.build.targets.wheel] packages = ["backend"]
# means it needs backend/ present on disk to build a valid wheel -- so
# both pyproject.toml and backend/ have to be copied in before `pip
# install .` runs, not just pyproject.toml on its own. That does mean a
# backend source change invalidates this layer too (not just a dependency
# change), but this project deploys rarely enough that the extra rebuild
# time doesn't matter, and it's the only way to get this right.
COPY pyproject.toml ./
COPY backend ./backend
RUN pip install --no-cache-dir .

# Railway (and most PaaS hosts) assign a container's public port at
# runtime via $PORT rather than a fixed number -- 8000 is only a fallback
# for running this image somewhere that doesn't set it. Binding 0.0.0.0
# (not 127.0.0.1) is what actually lets traffic from outside the
# container reach uvicorn at all.
CMD uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}